# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/

# Jupyter Checkpoints
.ipynb_checkpoints/

# Pytest cache
.pytest_cache/

# Datos y salidas (según arquitectura del proyecto)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep
